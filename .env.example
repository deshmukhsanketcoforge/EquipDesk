# Copy to .env (git-ignored) and fill in all three values; an empty one is reported
# as missing. Only the agent needs these; the api, db and the CI `test` job run
# without them. In CI they come from GitHub secrets.

# Foundry portal: Build > Models > your Claude deployment > Details.
FOUNDRY_API_KEY=
# The deployment's Target URI: https://<resource>.services.ai.azure.com/anthropic/
# (a trailing v1, v1/messages or query string is accepted and removed).
FOUNDRY_ENDPOINT=
# The deployment name. claude-opus-5-5-fast is Claude Opus 5.5's fast-mode deployment
# (the standard one is claude-opus-5-5); fast mode is chosen by the deployment, not a
# request setting.
FOUNDRY_MODEL_DEPLOYMENT=

# Optional. low | medium | high | xhigh | max (default medium). There is no
# temperature setting: Claude Opus 5.5 rejects non-default sampling parameters.
# FOUNDRY_EFFORT=medium
